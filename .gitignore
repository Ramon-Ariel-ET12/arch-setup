# OS
.DS_Store
Thumbs.db
*~
*.bak

# Secrets / local
.env
*.pem
*.key
*.secret

# Zsh - history is sensitive and local
zsh/.zsh_history
.zsh_history

# Editor / temp
*.swp
*.swo
*.tmp
*.log
*~

# Neovim - local overrides (previously in nvim/.gitignore)
nvim/.luarc.json
nvim/lazy-lock.json

# Hypr (previously in hypr/.gitignore)
# Matugen generated outputs (regenerated from wallpaper)
hypr/generated/
hypr/hyprlock.conf
hypr/.luarc.json

# AGS (previously in ags/.gitignore) - vendored deps + runtime outputs
ags/node_modules/
ags/@girs/
ags/dist/
ags/logs.log
ags/data/
ags/cache/
ags/.deps/
ags/.commandcode/
ags/opencode.json

# AGS generated palettes (regenerated at runtime)
ags/style/abstracts/_matugen.scss
ags/style/abstracts/_hyprland.scss

# Kitty - local runtime state
kitty/.luarc.json

# MPV - local editor config
mpv/.luarc.json

# Scratch / local experiments
temp/

# CommandCode learning state (local only)
.commandcode/
**/.commandcode/
