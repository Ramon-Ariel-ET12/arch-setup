# ============================================================================
# OS / filesystem metadata
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
.directory

# ============================================================================
# Secrets and machine-local credentials
# ============================================================================
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.crt
*.secret
id_rsa
id_ed25519

# ============================================================================
# Shell history (sensitive, machine-local)
# ============================================================================
.*_history
.lesshst

# ============================================================================
# Editor / IDE / temp artifacts
# ============================================================================
*~
*.bak
*.orig
*.rej
*.swp
*.swo
*.tmp
*.temp
*.log
*.tsbuildinfo
.eslintcache
.cache/
tags
.vscode/
.idea/
.direnv/

# ============================================================================
# Per-project local tool state (generic — covers every module directory)
# ============================================================================
**/.luarc.json
!**/hypr/hyprsplit/.luarc.json
**/node_modules/
**/.deps/
**/@girs/
**/.cache/
**/.commandcode/
ags/opencode.json

# Neovim: lockfile intentionally kept out of the repo (re-resolved per machine)
nvim/lazy-lock.json

# ============================================================================
# Generated at runtime (regenerated from wallpaper / templates)
# ============================================================================
hypr/generated/
hypr/hyprlock.conf
ags/style/abstracts/_matugen.scss
ags/style/abstracts/_hyprland.scss

# AGS: build output and runtime state
ags/dist/
ags/out/
ags/data/
ags/logs.log
ags/cache/

# Matugen output
matugen/generated/

# tmux runtime state (prompt history written by history-file)
tmux/history

# Scratch / local experiments
temp/

# Note: hypr/hyprsplit is a vendored upstream project and keeps its own
# .gitignore; it is intentionally left untouched.
